# ── Supabase ──────────────────────────────────────────────────
# Créer un projet sur https://supabase.com (gratuit)
# Copier les valeurs depuis Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Admin dashboard ───────────────────────────────────────────
# Mot de passe de la page /admin (choisir quelque chose de solide)
VITE_ADMIN_PASSWORD=wonder2024!

# ── Edge Functions (secrets côté Supabase — pas VITE_) ────────
# Configurer via : supabase secrets set NOM=valeur
# Brevo SMS : https://www.brevo.com (gratuit jusqu'à 300 SMS/jour)
BREVO_API_KEY=xkeysib-...
# Numéro du barbier au format international
BARBER_PHONE=+33612345678
# Adresse exacte envoyée la veille du RDV
SALON_ADDRESS=12 rue de la Paix, Brie-Comte-Robert 77170
# Numéro affiché comme expéditeur (max 11 caractères alphanum)
SMS_SENDER=WonderCut
